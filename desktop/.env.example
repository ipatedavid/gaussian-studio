RUNPOD_API_KEY=
RUNPOD_GRAPHQL_URL=https://api.runpod.io/graphql
RUNPOD_IMAGE=ghcr.io/nerfstudio-project/nerfstudio:latest
SSH_PRIVATE_KEY=~/.ssh/id_ed25519
INPUT_FOLDER=
INPUT_VIDEO=
INPUT_KIND=images
# 0 = automatic, about 3 frames per video second capped at 300.
VIDEO_FRAMES_TARGET=0
MAX_GPU_PRICE_PER_HOUR=0.55
MIN_GPU_VRAM_GB=24
CLOUD_TYPE=ALL
CONTAINER_DISK_GB=30
# Minimum workspace volume in GiB; the app raises this based on the selected photos or video.
VOLUME_GB=0
MIN_VCPU=1
MIN_MEMORY_GB=8
PIPELINE_MAX_STEPS=30000
PIPELINE_NUM_DOWNSCALES=1
